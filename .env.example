# Copy to .env (gitignored). Never commit real values.

# Model provider
ANTHROPIC_API_KEY=

# Hard global spend cap in USD for all paid model calls (enforced in harness/budget.py)
BUDGET_USD_TOTAL=
# Optional per-phase allowances inside the total: BUDGET_USD_<PHASE>, e.g. BUDGET_USD_PILOT=10
BUDGET_USD_DRYRUN=
BUDGET_USD_PILOT=
BUDGET_USD_EXP1=
BUDGET_USD_ROLLOUT=
BUDGET_USD_EXP2=

# Flagsmith (Cloud). Server-side environment key for the SDK.
FLAGSMITH_ENVIRONMENT_KEY=
# Environment API key used in Admin API paths (api/v1/environments/<key>/...)
FLAGSMITH_ENVIRONMENT_API_KEY=
# Legacy user auth token, Admin API only (the CLI rejects it); optional
FLAGSMITH_USER_TOKEN=
# Management (master) API key for the CLI; `flagsmith login` can be used instead
FLAGSMITH_API_KEY=
# Self-hosted only: SDK base URL ending in /api/v1/ and the events URL
FLAGSMITH_API_URL_SDK=
FLAGSMITH_EVENTS_API_URL=

# Queue and telemetry (local defaults work with `make services-up`)
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=

# Live board ingest
BOARD_INGEST_URL=
BOARD_INGEST_SECRET=

# Docker Hub (optional, raises image pull limits)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
