{
  "name": "fork-in-the-bill-board-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/fill-seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.4",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
