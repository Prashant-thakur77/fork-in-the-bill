# Copy to terraform.tfvars (gitignored) and fill in.
region         = "us-east-1"
operator_cidr  = "203.0.113.7/32" # your public IP, e.g. "$(curl -s https://checkip.amazonaws.com)/32"
ssh_public_key = "ssh-ed25519 AAAA... operator@laptop"

instance_type  = "r7i.2xlarge"
use_spot       = false # true = spot (cheaper, can be reclaimed mid-run)
spot_max_price = ""   # empty = capped at the on-demand price
root_volume_gb = 1500

repo_url = "https://github.com/OWNER/fork-in-the-bill.git"
repo_ref = "main"

prepull_images = [
  # "starryzhang/sweb.eval.x86_64.owner_1776_repo-1234@sha256:...",
]

budget_usd   = 50 # AWS spend only; model spend is capped separately (BUDGET_USD_TOTAL)
budget_email = "alerts@example.com"
# operator_extra_cidrs = ["198.51.100.9/32"] # further addresses you connect from, if your IP alternates
