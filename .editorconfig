root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

# Registration files are hashed in prereg/HASHES.txt, and run logs feed the ledgers and the
# analysis. An editor must not tidy either.
[{prereg/**,runs/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
indent_style = unset
indent_size = unset
