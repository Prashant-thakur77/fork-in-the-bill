{
  "name": "forkbill",
  "version": "0.1.0",
  "description": "Routed lanes for Node agent loops, driven by a Flagsmith experiment flag: policy per task, exposure, outcome events, pricing and offline assignment checks",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prashant-thakur77/fork-in-the-bill.git",
    "directory": "kit/ts"
  },
  "homepage": "https://forkbill.prashantthakur.dev",
  "bugs": {
    "url": "https://github.com/Prashant-thakur77/fork-in-the-bill/issues"
  },
  "keywords": [
    "flagsmith",
    "feature-flags",
    "experimentation",
    "ab-testing",
    "llm",
    "agents",
    "model-routing"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "~5.9.3"
  }
}
